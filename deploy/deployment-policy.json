{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "IdentifyCaller",
      "Effect": "Allow",
      "Action": ["sts:GetCallerIdentity"],
      "Resource": "*"
    },
    {
      "Sid": "ManageTheKebeeraExecutionRole",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:CreateRole",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:PutRolePolicy",
        "iam:GetRolePolicy",
        "iam:ListAttachedRolePolicies",
        "iam:ListRolePolicies",
        "iam:TagRole"
      ],
      "Resource": "arn:aws:iam::723591018551:role/smart-farmer-lambda-role"
    },
    {
      "Sid": "AttachAwsManagedLambdaLoggingPolicy",
      "Effect": "Allow",
      "Action": ["iam:AttachRolePolicy", "iam:DetachRolePolicy"],
      "Resource": "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
    },
    {
      "Sid": "PassRoleToLambda",
      "Effect": "Allow",
      "Action": ["iam:PassRole"],
      "Resource": "arn:aws:iam::723591018551:role/smart-farmer-lambda-role"
    },
    {
      "Sid": "ManageTheKebeeraFunction",
      "Effect": "Allow",
      "Action": [
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:CreateFunction",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:DeleteFunction",
        "lambda:ListFunctions",
        "lambda:TagResource"
      ],
      "Resource": "arn:aws:lambda:us-east-1:723591018551:function:smart-farmer-diagnose"
    },
    {
      "Sid": "SetTheSpendingCapOnTheFunction",
      "Effect": "Allow",
      "Action": [
        "lambda:PutFunctionConcurrency",
        "lambda:GetFunctionConcurrency",
        "lambda:DeleteFunctionConcurrency"
      ],
      "Resource": "arn:aws:lambda:us-east-1:723591018551:function:smart-farmer-diagnose"
    },
    {
      "Sid": "LetApiGatewayInvokeTheFunction",
      "Effect": "Allow",
      "Action": ["lambda:AddPermission", "lambda:GetPolicy", "lambda:RemovePermission"],
      "Resource": "arn:aws:lambda:us-east-1:723591018551:function:smart-farmer-diagnose"
    },
    {
      "Sid": "ManageApiGateway",
      "Effect": "Allow",
      "Action": [
        "apigateway:GET",
        "apigateway:POST",
        "apigateway:PATCH",
        "apigateway:PUT",
        "apigateway:DELETE"
      ],
      "Resource": "arn:aws:apigateway:us-east-1::/*"
    },
    {
      "Sid": "ManageLambdaArtifactsBucket",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::smart-farmer-lambda-artifacts-*",
        "arn:aws:s3:::smart-farmer-lambda-artifacts-*/*"
      ]
    },
    {
      "Sid": "ReadLogsWhenSomethingBreaks",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogGroups",
        "logs:DescribeLogStreams",
        "logs:FilterLogEvents",
        "logs:GetLogEvents",
        "logs:CreateLogGroup",
        "logs:PutRetentionPolicy"
      ],
      "Resource": "*"
    },
    {
      "Sid": "MonthlyBudgetAlert",
      "Effect": "Allow",
      "Action": ["budgets:ViewBudget", "budgets:ModifyBudget"],
      "Resource": "*"
    },
    {
      "Sid": "ExplainWhichPermissionsAreMissing",
      "Effect": "Allow",
      "Action": ["iam:SimulatePrincipalPolicy"],
      "Resource": "*"
    },
    {
      "Sid": "BedrockInference",
      "Effect": "Allow",
      "Action": ["bedrock:InvokeModel", "bedrock:InvokeModelWithResponseStream"],
      "Resource": [
        "arn:aws:bedrock:us-east-1::foundation-model/*",
        "arn:aws:bedrock:*:723591018551:inference-profile/*"
      ]
    },
    {
      "Sid": "BedrockModelAccessAutoEnable",
      "Effect": "Allow",
      "Action": [
        "aws-marketplace:Subscribe",
        "aws-marketplace:Unsubscribe",
        "aws-marketplace:ViewSubscriptions"
      ],
      "Resource": "*"
    }
  ]
}
