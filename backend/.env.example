# ─────────────────────────────────────────────────────────────────────────────
# Smart Farmer backend — environment variable template
#
# Copy this file to .env and fill in real values for your machine:
#     cp backend/.env.example backend/.env      (Windows: copy backend\.env.example backend\.env)
#
# .env is listed in .gitignore and must NEVER be committed. This template is
# committed instead so everyone can see which variables the backend reads.
# Nothing in this file is a real secret — every value below is a safe default.
#
# AWS credentials are NOT read from this file by the backend itself. The AWS SDK
# (boto3) resolves them from its normal credential chain, which means keys can
# come from any of these instead:
#   * running `aws configure` (writes ~/.aws/credentials + ~/.aws/config)
#   * environment variables (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN)
#   * an IAM role attached to the EC2 instance / ECS task / Lambda running the API
# If the AWS CLI is already configured (or the app runs on AWS with a role), you
# do not need to put any keys in this file at all — leave the AWS_* entries below
# blank/at their defaults and the default credential chain will just work.
# ─────────────────────────────────────────────────────────────────────────────

# Which diagnosis engine to use: "bedrock" (default, calls AWS) or "onnx" (local model file)
DIAGNOSIS_PROVIDER=bedrock

# --- AWS / Amazon Bedrock ---
# Region used for the Bedrock RUNTIME endpoint.
# NOTE: the Bedrock runtime API is NOT available in af-south-1 (Cape Town), so this
# must be a region that has a bedrock-runtime endpoint. us-east-1 is the default here.
AWS_REGION=us-east-1
# Optional named profile from ~/.aws/credentials. Leave blank to use the default chain.
AWS_PROFILE=
# Amazon Nova model id. Must be a Nova variant that accepts IMAGE input.
# amazon.nova-micro-v1:0 is TEXT ONLY and will NOT work here.
# Cheap and fast: amazon.nova-lite-v1:0   Higher accuracy: amazon.nova-pro-v1:0
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# Longest edge in pixels that an uploaded image is downscaled to before being sent
# to Bedrock. Nova bills per image token (roughly 1300 tokens for a 900x900 image),
# so this caps cost and latency. Raise it only if accuracy suffers.
BEDROCK_MAX_IMAGE_DIM=1024
# Max tokens the model may generate for the JSON answer. The answer is very small.
BEDROCK_MAX_TOKENS=400
# Sampling temperature. 0 is correct for a classification / labelling task.
BEDROCK_TEMPERATURE=0

# --- Server ---
# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Local ONNX provider (only used when DIAGNOSIS_PROVIDER=onnx) ---
# Path to a local .onnx model file. Requires backend/requirements-onnx.txt installed.
#
# Leave this commented out unless you need to override it. When unset, the code
# defaults to <backend>/model/plantvillage.onnx resolved relative to inference.py,
# so it works no matter which directory you launch uvicorn from.
#
# If you DO set it, note that a relative path is resolved against the current
# working directory, not the backend directory. Setting it to
# "backend/model/plantvillage.onnx" and then starting the server with
# `cd backend && uvicorn main:app` would look for backend/backend/model/... and fail.
# MODEL_PATH=C:/path/to/plantvillage.onnx
